# NNUE: 採用判定に落ちた実験モデル群(gen番号は探索のたびに大量発生する)。
# チャンピオン(gen092/gen113系/gen137等)は明示的に git add 済みのため
# 既に追跡中のファイルはこのパターンの影響を受けない。
models/*.bin
models/*.json
models/*.golden.json
!models/gen092.*
!models/gen113.*
!models/gen114.*
!models/gen115.*
!models/gen118.*
!models/gen119.*
!models/gen120.*
!models/gen121.*
!models/gen122.*
!models/gen137.*

